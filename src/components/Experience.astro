---
const jobs = [
  {
    title: "Event Planning & Operation Trainee",
    place: "Travel agency (internship)",
    points: [
      "Discussed itinerary and activity needs with clients",
      "Researched and planned trips, prepared quotations to fit budget",
      "Handled documentation, flight and insurance purchases",
      "Prepared marketing materials",
    ],
  },
  {
    title: "Teacher",
    place: "One-month role",
    points: [],
  },
  {
    title: "Promotional Event Helper",
    place: "Part-time",
    points: [
      "Demoed and explained electrical appliance features",
      "Helped customers find products that fit their budget",
      "Collected customer preferences and feedback",
    ],
  },
];
---
<section class="wrap" id="experience">
  <br>
  <h2>Experience</h2>
  <div class="jobs">
    {jobs.map((job) => (
      <article class="job">
        <h3>{job.title}</h3>
        <p class="place muted">{job.place}</p>
        {job.points.length > 0 && (
          <ul>
            {job.points.map((point) => <li>{point}</li>)}
          </ul>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .jobs {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .job h3 {
    font-family: var(--serif);
    font-size: 18px;
    margin: 0 0 2px;
  }
  .place {
    margin: 0 0 10px;
    font-size: 15px;
  }
  .job ul {
    margin: 0;
    padding-left: 18px;
  }
  .job li {
    margin-bottom: 4px;
  }
</style>
