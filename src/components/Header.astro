---
---
<header class="header">
  <div class="wrap header-inner">
    <div class="mark" aria-hidden="true">JC</div>
    <div>
      <h1>Fan Lok Men </h1>
      <h3 class="role">Applied Mathematics graduate, moving into HR</h3>
    </div>
  </div>
</header>

<style>
  .header {
    padding: 56px 0 40px;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .mark {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-family: var(--serif);
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  h1 {
    font-family: var(--serif);
    font-size: 30px;
    margin: 0 0 4px;
  }
  .role {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .header {
      padding: 40px 0 28px;
    }
  }
</style>
